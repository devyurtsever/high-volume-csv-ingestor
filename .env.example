# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/customer_import_db
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=customer_import_db
DB_MAX_CONNECTIONS=20

# Redis (BullMQ Queue)
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380

# Uploads & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=524288000 # 500 MB

# Security & Concurrency
API_KEY=dev-local-key-change-me
WORKER_CONCURRENCY=2
BATCH_SIZE=2000
DELETE_FILE_AFTER_IMPORT=false
